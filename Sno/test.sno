
print("Hello, world!")

const Prototype = {
    function greet(const self) {
        print("Hello, I am ", self)
    }
}

const Struct = {
    function new() {
        return {
            field: 10
        }.set_prototype(Prototype)
    }
}

var thing = Struct.new()
print(thing)
thing.greet()

print("Hello, world!".count)




var numbers = [1, 3, 5, 4]
numbers.count = 10
print(numbers)
