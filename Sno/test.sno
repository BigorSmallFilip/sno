
const file_to_number = {
    "a": 0, "b": 1, "c": 2, "d": 3, "e": 4, "f": 5, "g": 6, "h": 7
}
const rank_to_number = {
    "1": 0, "2": 1, "3": 2, "4": 3, "5": 4, "6": 5, "7": 6, "8": 7
}

function check_if_index_valid(index) {
    return index >= 0 or index <= 7
}

function parse_coord(str) {
    var x = file_to_number[str[0]]
    var y = rank_to_number[str[1]]
    if  not check_if_index_valid(x) or
        not check_if_index_valid(y) {
        return none
    }
    return [x, y]
}

function parse_move(move, whites_turn) {
    if move.count != 4 {
        return none
    }
    var from_x = file_to_number[move[0]]
    var from_y = rank_to_number[move[1]]
    var to_x = file_to_number[move[2]]
    var to_y = rank_to_number[move[3]]
    if  not check_if_index_valid(from_x) or
        not check_if_index_valid(from_y) or
        not check_if_index_valid(to_x) or
        not check_if_index_valid(to_y) {
        return none
    }
    return [from_x, from_y, to_x, to_y]
}



const ChessBoardPrototype = {
    function print(const self, whites_perspective) {
        var row_names = none
        if whites_perspective {
            row_names = "     A B C D E F G H"
        } else {
            row_names = "     H G F E D C B A"
        }
        print(row_names)
        print("    -----------------")
        if whites_perspective {
            for y = 0, 8 {
                printnl(" ", 8 - y, " | ")
                for x = 0, 8 {
                    printnl(self.field[x + (7 - y) * 8], " ")
                }
                print("| ", 8 - y)
            }
        } else {
            for y = 0, 8 {
                printnl(" ", y + 1, " | ")
                for x = 0, 8 {
                    printnl(self.field[(7 - x)  + y * 8], " ")
                }
                print("| ", y + 1)
            }
        }
        
        print("    -----------------")
        print(row_names)
    }

    function get(const self, x, y) {
        if x < 0 and x > 7 or
           y < 0 and y > 7 {
            return none
        }
        return self.field[x + y * 8]
    }

    function input_move(self) {
        if self.whites_turn {
            printnl("White to move > ")
        } else {
            printnl("Black to move > ")
        }
        return input()
    }

    function parse_move(self, move_string) {
        if move_string.count == 0 {
            return none, "No input"
        }
        if move_string[0].is_lower() {
            // Pawn move probably
            var x = file_to_number[move_string[0]]
            if x == none {
                return none, "Invalid file"
            }
            var y = -1
            if move_string.count == 2 {
                y = rank_to_number[move_string[1]]
                if y == none {
                    return none, "Invalid rank"
                }
            }
            if self.get(x, y) != "." {
                return none, "Other piece in the way"
            }
            if self.whites_turn {
                var down_one = self.get(x, y - 1)
                if down_one == "P" {
                    return [x, y - 1, x, y]
                } else if y == 3 and self.get(x, y - 2) == "P" {
                    if down_one != "." {
                        return none, "Other piece in the way"
                    }
                    return [x, y - 2, x, y]
                }
            } else {
                // Black pawn move
                var up_one = self.get(x, y + 1)
                if up_one == "p" {
                    return [x, y + 1, x, y]
                } else if y == 4 and self.get(x, y + 2) == "p" {
                    if up_one != "." {
                        return none, "Other piece in the way"
                    }
                    return [x, y + 2, x, y]
                }
            }
            return none, "No pawn can move there"
        }
        return parse_move(move_string, self.whites_turn)
    }

    function perform_move(self, move) {
        if typename(move) != "array" or
            move.count != 4 {
            return
        }
        var from = move[0] + move[1] * 8
        var to = move[2] + move[3] * 8

        var piece = self.field[from]
        self.field[from] = "."
        self.field[to] = piece

        self.whites_turn = not self.whites_turn
        return true
    }
}

const ChessBoard = {
    function new() {
        var field = [
            "R", "N", "B", "Q", "K", "B", "N", "R",
            "P", "P", "P", "P", "P", "P", "P", "P",
            ".", ".", ".", ".", ".", ".", ".", ".",
            ".", ".", ".", ".", ".", ".", ".", ".",
            ".", ".", ".", ".", ".", ".", ".", ".",
            ".", ".", ".", ".", ".", ".", ".", ".",
            "p", "p", "p", "p", "p", "p", "p", "p",
            "r", "n", "b", "q", "k", "b", "n", "r",
        ]
        return {
            field: field
            whites_turn: true
        }.set_prototype(ChessBoardPrototype)
    }
}



var board = ChessBoard.new()
board.print()

while true {
    var move_string = board.input_move()
    var start = perftimer()
    var move, err = board.parse_move(move_string)
    if err != none {
        print(err)
    } else {
        print("The parsed move is ", move)
        board.perform_move(move)
    }
    board.print(true)
    var duration = perftimer() - start
    print("That took ", duration * 1000, "ms to calculate")
}
